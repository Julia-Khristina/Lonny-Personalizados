# Copie para .env.local (não vai para o git) e preencha.
# Variáveis SEM o prefixo VITE_ ficam só no servidor — nunca chegam ao navegador.

# Chave da API do Gemini (https://aistudio.google.com/apikey) — prévia realista com IA no passo 3
GEMINI_API_KEY=

# Opcional: modelo de edição de imagem (padrão: gemini-nano-banana-2.1)
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
